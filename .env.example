# Copy to .env (or let tools/setup-local.sh generate it with a random password).
# Used by docker-compose.yml for the local SQL Server container. Local development only.

# SA password for the local SQL Server container. SQL Server requires 8+ characters
# with upper case, lower case, digits and a symbol.
HSK_SQL_SA_PASSWORD=CHANGE_ME_Local_1

# Optional: password for the demo accounts (director / operations) that
# tools/setup-local.sh writes into local.settings.json. Defaults to "demo".
HSK_DEMO_PASSWORD=demo
