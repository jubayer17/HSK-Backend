<Project>
  <!-- The Durable Task analyzer needs a newer C# compiler than the .NET 8.0.1xx SDK ships; it only adds code hints. -->
  <Target Name="RemoveDurableTaskAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.DurableTask.Analyzers'" />
    </ItemGroup>
  </Target>
</Project>
